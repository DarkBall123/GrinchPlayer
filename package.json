{
	"name": "grinch-player",
	"productName": "GrinchPlayer",
	"version": "1.7.2",
	"description": "Технопранк-плеер",
	"license": "CC BY-NC-SA 4.0",
	"author": {
		"name": "Nik"
	},
	"scripts": {
		"postinstall": "electron-builder install-app-deps",
		"check": "node --check index.js && node --check custom.js && node --check config.js && node --check ai-core.js && node --check ai-memory.js && node --check ai-service.js && node --check ai-renderer.js && node --check ai-audio-utils.mjs && node --check ai-audio-worklet.mjs && node --check vendor/howler.js",
		"lint": "eslint .",
		"test": "npm run check && node --test && npm run lint",
		"start": "electron .",
		"pack": "electron-builder --dir --win --x64",
		"dist": "electron-builder --win --x64",
		"win": "electron-builder --win --x64",
		"sass": "sass --no-source-map index.scss index.css"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@sindresorhus/slugify": "^0.9.1",
		"bulma": "^0.7.5",
		"bulma-extensions": "^6.2.7",
		"bulmaswatch": "^0.7.2",
		"electron-store": "7.0.3",
		"fancy-textfill": "^1.2.5",
		"farmhashjs": "1.0.1",
		"fast-glob": "^3.0.2",
		"filenamify": "^4.1.0",
		"fork-awesome": "^1.1.7",
		"fuse.js": "^3.4.6",
		"hotkeys-js": "^3.6.11",
		"iconv-lite": "^0.5.0",
		"jquery": "^3.4.1",
		"jquery-jeditable": "^2.0.10",
		"jquery-ui-dist": "^1.12.1",
		"list.js": "^1.5.0",
		"lodash": "^4.17.11",
		"moment": "^2.24.0",
		"shepherd.js": "^5.0.0",
		"simplebar": "^4.1.0",
		"tippy.js": "^4.3.4",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"electron": "43.2.0",
		"electron-builder": "26.15.3",
		"eslint": "10.7.0",
		"sass": "^1.102.0"
	},
	"build": {
		"appId": "com.Nik.GrinchPlayer",
		"files": [
			"**/*",
			"!.env",
			"!test/**"
		],
		"extraResources": "sounds/*.ogg",
		"win": {
			"target": [{
				"target": "portable",
				"arch": [
					"x64"
				]
			}],
			"icon": "build/icon.png",
			"artifactName": "${productName}-${version}-win-${arch}.${ext}"
		}
	}
}
